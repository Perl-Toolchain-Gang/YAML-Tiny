=== multiline quote
--- yaml
- 'Multiline
quote'
--- error: E_FEATURE

=== dash dash 2
--- yaml
- - 2
--- error: E_PLAIN

=== dash
--- yaml
foo: -
--- error: E_PLAIN

=== leading ampersand
--- yaml
foo: @INC
--- error: E_PLAIN

=== leading percent
--- yaml
foo: %INC
--- error: E_PLAIN

=== trailing colon
--- yaml
foo: bar:
--- error: E_PLAIN

=== key key value
--- yaml
foo: bar: baz
--- error: E_PLAIN

=== backticks
--- yaml
foo: `perl -V`
--- error: E_PLAIN

=== double-dash
--- yaml
--
--- error: E_PLAIN

=== multi-line scalar document starting on header
--- yaml
\--- foo
bar
--- error: E_CLASSIFY

=== alias indicator in sequence
--- yaml
- *foo
--- error: E_PLAIN

=== flow sequence in sequence
--- yaml
- [foo]
--- error: E_PLAIN

=== flow mapping in sequence
--- yaml
- {foo}
--- error: E_PLAIN

=== flow mapping with value in sequence
--- yaml
- {xxx: yyy}
--- error: E_PLAIN

=== explicit key indicator in sequence
--- yaml
- ? foo
--- error: E_PLAIN

=== comma in sequence
--- yaml
- ,foo
--- error: E_PLAIN

=== flow sequence end in sequence
--- yaml
- ]foo
--- error: E_PLAIN

=== flow mapping end in sequence
--- yaml
- }foo
--- error: E_PLAIN

=== alias indicator as value
--- yaml
foo: *bar
--- error: E_PLAIN

=== flow sequence as value
--- yaml
foo: [bar]
--- error: E_PLAIN

=== flow mapping as value
--- yaml
foo: {bar}
--- error: E_PLAIN

=== explicit key indicator as value
--- yaml
foo: ? bar
--- error: E_PLAIN
