#####################################################################
# Main Tests

=== Properly ignore comments
--- yaml
---
a: b#content
c: d #comment
e:
- f #comment
- g# content
h: 'single'                 # comment
h2: 'single # content'      # comment
i: "double"                 # comment
i2: "double # content"      # comment
j: |        # comment
    literal # content
    block   # content
k: {}       # comment
l: []       # comment
m:      # comment
  n: o
--- perl
[
    {
        a => 'b#content',
        c => 'd',
        e => [
            'f',
            'g# content',
        ],
        h => 'single',
        h2 => 'single # content',
        i => 'double',
        i2 => 'double # content',
        j => "literal # content\nblock   # content\n",
        k => {},
        l => [],
        m => {
            n => 'o',
        },
    },
]
--- noyamlpm


# Repeat, with otherwise illegal characters in the comments
=== Properly ignore comments (with otherwise illegal characters)
--- yaml
---
a: b#content
c: d #comment '"!&@%`
e:
- f #comment '"!&@%`
- g# content
h: 'single'                 # comment '"!&@%`
h2: 'single # content'      # comment '"!&@%`
i: "double"                 # comment '"!&@%`
i2: "double # content"      # comment '"!&@%`
j: |        # comment '"!&@%`
    literal # content
    block   # content
k: {}       # comment '"!&@%`
l: []       # comment '"!&@%`
m:      # comment '"!&@%`
  n: o
--- perl
[
    {
        a => 'b#content',
        c => 'd',
        e => [
            'f',
            'g# content',
        ],
        h => 'single',
        h2 => 'single # content',
        i => 'double',
        i2 => 'double # content',
        j => "literal # content\nblock   # content\n",
        k => {},
        l => [],
        m => {
            n => 'o',
        },
    },
]
--- noyamlpm

####################################################################
# Lines starting with # inside literal blocks must be preserved as content
# (RT#52 / GitHub#52)

=== comment_lines_in_literal_block
--- yaml
---
whatever: |
   #!/bin/bash
   env
   # another comment
      # indented comment
   # back from indentation
--- perl
[ { whatever => "#!/bin/bash\nenv\n# another comment\n   # indented comment\n# back from indentation\n" } ]
--- noyamlpm


=== comment_lines_in_literal_block_in_sequence
--- yaml
---
- |
  # Perl sub:
  sub foo {}
--- perl
[ [ "# Perl sub:\nsub foo {}\n" ] ]
--- noyamlpm


####################################################################
# Comment on the Document Line

=== comment header
--- yaml
--- # Comment
foo: bar
--- perl
[ { foo => 'bar' } ]
--- noyamlpm


# Empty comments
=== empty_comment_in_list
--- yaml
---
- foo
\#
- bar

--- perl
[ [ 'foo', 'bar' ] ]


=== empty_comment_in_hash
--- yaml
---
foo: bar
\# foo
one: two

--- perl
[ { foo => 'bar', one => 'two' } ]


